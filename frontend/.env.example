# URL base de la API REST del backend (sin barra final)
VITE_API_URL=http://localhost:8080/api

# true  -> la app usa datos simulados en memoria (no necesita backend)
# false -> la app llama al backend en VITE_API_URL
VITE_USE_MOCK=true

# browser -> rutas normales (/almacen/materiales). Requiere que el servidor redirija todo a index.html
# hash    -> rutas con # (/#/almacen/materiales). Sirve en cualquier hosting estático
VITE_ROUTER_MODE=browser
